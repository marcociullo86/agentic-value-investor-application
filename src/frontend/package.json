{
  "name": "value-investing-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend SPA per WebApp Value Investing (Next.js 16 App Router + React 19, static export).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:realbe": "playwright test --config=playwright.config.realbe.ts",
    "playwright:install": "playwright install --with-deps",
    "generate:api": "openapi-typescript \"../../design_&_architecture/api/openapi.yaml\" -o lib/api/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.1.6",
    "ag-grid-community": "32.3.3",
    "ag-grid-react": "32.3.3",
    "axios": "1.7.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "16.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.0",
    "swr": "2.4.1",
    "tailwind-merge": "2.5.5",
    "tailwindcss": "3.4.17",
    "zod": "3.24.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "16.0.3",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.6.1",
    "postcss": "8.4.49",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
