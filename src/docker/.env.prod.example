# Production environment template — src/docker/.env.prod.example
# [^src: design_&_architecture/decisions/ADR-015-deployment-target-r11.md §Decisione]
# [^src: management/kanban/EP-008-deploy-operativita-produzione/US-026-baseline-target-deploy/TSK-062.md]
#
# USAGE:
#   cp src/docker/.env.prod.example src/docker/.env.prod
#   chmod 600 src/docker/.env.prod   # restrict to owner only — never world-readable
#   # Fill in all <change-me-*> placeholders before first deploy
#
# This file is committed to VCS without real secrets.
# The real .env.prod is gitignored — see src/docker/.gitignore
#
# Cross-reference: docs/deploy/production-secrets-checklist.md

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=value_investing_prod
POSTGRES_USER=vi_prod_user
POSTGRES_PASSWORD=<change-me-strong-password>

# ─── Spring ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ─── JWT signing (>= 256-bit / 32 bytes base64-encoded) ─────────────────────
# Generate: openssl rand -base64 32
JWT_SIGNING_SECRET=<change-me-256-bit-secret-base64>

# ─── FMP API ─────────────────────────────────────────────────────────────────
FMP_API_KEY=<change-me-fmp-key>
FMP_BASE_URL=https://financialmodelingprep.com/stable

# ─── SEC EDGAR ───────────────────────────────────────────────────────────────
# Valid, reachable email — required by SEC fair-access policy
SEC_EDGAR_USER_AGENT_EMAIL=<change-me-valid-email@example.com>

# ─── Anthropic LLM (Munger + News Scout) ─────────────────────────────────────
ANTHROPIC_API_KEY=<change-me-anthropic-key>

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.app.example.com

# ─── Domain (nginx TLS certificate path) ────────────────────────────────────
APP_DOMAIN=app.example.com

# ─── Backup directory (host path mounted into vi-postgres container) ─────────
BACKUP_DIR=/var/backups/postgres

# ─── Top Picks batch job (EP-012 / US-047) ───────────────────────────────────
TOP_PICKS_ENABLED=true
TOP_PICKS_CRON=0 0 2 * * *
TOP_PICKS_ZONE=UTC

# ─── LLM budget runtime guard ────────────────────────────────────────────────
LLM_BUDGET_MONTHLY_USD=50

# ─── Localisation / timezone ─────────────────────────────────────────────────
TZ=UTC
LANG=en_US.UTF-8
