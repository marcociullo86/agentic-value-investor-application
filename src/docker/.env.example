# Sample environment for src/docker/docker-compose.yml
# Copy to `.env` (gitignored) and fill values.
# [^src: design_&_architecture/decisions/ADR-009-deployment-target.md §Variabili d'ambiente]

# ---- Spring profile selector ----
SPRING_PROFILES_ACTIVE=dev

# ---- PostgreSQL (compose) ----
POSTGRES_DB=value_investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- App DB connection (inside the compose network) ----
DB_URL=jdbc:postgresql://postgres:5432/value_investing
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- FMP integration ----
# [^src: design_&_architecture/decisions/ADR-004-fmp-integration.md]
FMP_API_KEY=replace-me
FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# ---- JWT signing (>= 256 bits required in prod) ----
# [^src: design_&_architecture/decisions/ADR-006-authentication.md §Token]
JWT_SIGNING_SECRET=replace-with-a-secret-of-at-least-32-bytes-base64-or-utf8

# ---- CORS allowed origins (CSV) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
