# Sample environment for src/docker/docker-compose.yml
# Copy to `.env` (gitignored) and fill values.
#
# Questo file è l'UNICO entry point della configurazione runtime: il servizio
# `app` lo carica via `env_file`, quindi OGNI variabile qui definita raggiunge
# Spring Boot. I valori riportati replicano i default di
# src/backend/src/main/resources/application.yml — sovrascrivi solo ciò che serve.
# [^src: design_&_architecture/decisions/ADR-009-deployment-target.md §Variabili d'ambiente]

# =============================================================================
# BACKEND (Spring Boot — Kotlin)
# =============================================================================

# ---- Spring profile selector ----
SPRING_PROFILES_ACTIVE=dev
# Abilita @Scheduled (TopValuePicksJob, purge job). false in dev/test per skip cron.
SPRING_TASK_SCHEDULING_ENABLED=true

# ---- PostgreSQL (compose) ----
POSTGRES_DB=value_investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- App DB connection (inside the compose network) ----
# NB: DB_URL ed EMBEDDINGS_SIDECAR_URL sono ri-pinati dal compose sugli hostname
# dei service (postgres / embeddings-sidecar); qui i valori sono per coerenza.
DB_URL=jdbc:postgresql://postgres:5432/value_investing
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- Security — JWT / cookie (ADR-006 / ADR-010) ----
JWT_SIGNING_SECRET=replace-with-a-secret-of-at-least-32-bytes-base64-or-utf8
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookie auth con flag Secure (true in prod/HTTPS; false solo per dev su http).
AUTH_COOKIE_SECURE=true

# ---- Security — brute-force lockout purge (ADR-025) ----
# Cron Spring 6-field (seconds minutes hours DoM month DoW); default 04:00 UTC.
BRUTE_FORCE_CLEANUP_CRON=0 0 4 * * *
BRUTE_FORCE_CLEANUP_ZONE=UTC

# ---- Security — Cloudflare Turnstile (ADR-025 §5) ----
# secret-key vuota disabilita la verifica server-side (qualsiasi token è valido).
# In prod impostare TURNSTILE_SECRET_KEY con la secret reale.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5

# ---- Security — HaveIBeenPwned password check ----
HIBP_ENABLED=true
HIBP_API_URL=https://api.pwnedpasswords.com/range/

# ---- Security — MFA / TOTP ----
MFA_ISSUER=ValueInvestor
MFA_TOTP_PERIOD_SECONDS=30
MFA_RECOVERY_CODES_COUNT=8
# Chiave AES per cifrare i secret TOTP a riposo (>= 32 char in prod).
# Vuota → in profilo dev usa un default di sviluppo; in prod DEVE essere impostata.
MFA_ENCRYPTION_KEY=

# ---- Logging retention GDPR (ADR-021 §7) ----
LOG_RETENTION_OPS_DAYS=30
LOG_RETENTION_SECURITY_DAYS=365

# ---- FMP integration (ADR-004) ----
FMP_API_KEY=replace-me
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_RATE_LIMIT_PER_MINUTE=30
FMP_EVENT_LOG_RETENTION_DAYS=90
FMP_CACHE_PROFILE_TTL_HOURS=1
# Rate limit/timeout dedicati al batch TopValuePicksJob (separati dall'online).
FMP_BATCH_RATE_LIMIT_PER_MINUTE=300
FMP_BATCH_TIMEOUT_SECONDS=30
# FmpEventLogMaintenanceJob — purge fmp_api_event_log oltre retention. 03:00 UTC.
FMP_EVENT_LOG_PURGE_CRON=0 0 3 * * *
FMP_EVENT_LOG_PURGE_ZONE=UTC

# ---- SEC EDGAR integration (TSK-091 / US-038 / EP-011) ----
# Email valida raggiungibile per fair-access-policy SEC. Senza email
# identificativa, la SEC può rispondere 403 / bannare il User-Agent.
# [^src: management/kanban/EP-011-deep-analysis-10k-10q/US-038-sec-edgar-adapter/TSK-091.md §7]
SEC_EDGAR_USER_AGENT_EMAIL=replace-with-valid-email@yourdomain.com
SEC_EDGAR_BASE_URL=https://data.sec.gov
SEC_EDGAR_FILES_URL=https://www.sec.gov

# ---- Embeddings sidecar (ADR-018) ----
EMBEDDINGS_SIDECAR_URL=http://embeddings-sidecar:8001
EMBEDDINGS_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Build arg + runtime env del container embeddings-sidecar (compose service).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---- Anthropic Claude (ADR-017 / TSK-104) ----
# Vuoto → AnthropicClientStub (dev/test). Impostare per il client reale.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_CLIENT_IMPL=rest
ANTHROPIC_RATE_LIMIT_PER_MINUTE=12

# ---- LLM budget runtime guard (ADR-019) ----
LLM_BUDGET_MONTHLY_CAP_USD=50.00
LLM_BUDGET_ABSOLUTE_MAX_USD=10000

# ---- Top Value Picks batch (EP-012 / US-048) ----
TOP_PICKS_ENABLED=false
# Cron Spring 6-field (seconds minutes hours DoM month DoW); default 02:00 UTC.
TOP_PICKS_CRON=0 0 2 * * *
TOP_PICKS_ZONE=UTC

# =============================================================================
# FRONTEND (Next.js) — consumate al build-time (NEXT_PUBLIC_* esposte al browser)
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BUILD_VERSION=0.1.0-dev
